{
  "name": "@florent-uzio/waas",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Palisade Wallet-as-a-Service API, generated from OpenAPI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "add-changeset": "changeset",
    "build": "tsc",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "check-format": "prettier --check .",
    "ci": "npm run build && npm run check-format && npm run test",
    "dev": "vitest",
    "format": "prettier --write .",
    "generate:waas-types": "npx openapi-typescript ./openapi/palisade-api.json -o ./src/models/waas-types.ts && prettier --write ./src/models/waas-types.ts",
    "local-release": "changeset version && changeset publish",
    "prepare": "npm run build",
    "release": "changeset publish",
    "prepublishOnly": "npm run build && npm run check-format && npm run test",
    "sort-package": "npx sort-package-json",
    "start": "npm run build && node dist/main.js",
    "test": "vitest run --reporter verbose",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "qs": "^6.13.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.1",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^22.7.5",
    "@types/qs": "^6.9.16",
    "@vitest/coverage-v8": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "dotenv": "^16.4.5",
    "openapi-typescript": "^7.4.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
